+class ComplaintDetailsScreen extends StatefulWidget {
+  const ComplaintDetailsScreen({
+    super.key,
+    required this.summary,
+    required this.repository,
+  });
+
+  final ComplaintReport summary;
+  final ComplaintsRepository repository;
